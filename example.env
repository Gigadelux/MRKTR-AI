# Copy to .env and fill in. Never commit .env or real values.

# --- Company profile (gitignore/data/<company>/) ---
ACTIVE_COMPANY=

# --- Local servers (keep on 127.0.0.1: the dashboard has no login) ---
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# --- LLM (OpenAI-compatible: OpenRouter, Venice AI) ---
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Content guard (Llama Guard via an OpenAI-compatible provider) ---
GUARD_PROVIDER=
GUARD_MODEL=
GUARD_API_KEY=

# --- Injection guard (Prompt Guard, local Hugging Face model) ---
INJECTION_GUARD_MODEL=

# --- Text-to-speech ---
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=
MAX_VOICE_NOTES_PER_CONVERSATION=5
# No content guard yet: voice notes are refused unless this is true. Dev bot only.
DEV_ALLOW_UNGUARDED_VOICE=false

# --- Speech-to-text ---
STT_PROVIDER=
STT_API_KEY=

# --- Tutorial videos (Remotion render endpoint) ---
REMOTION_ENDPOINT=
REMOTION_API_KEY=

# --- RAG (Milvus Lite file in gitignore/temp/rag/, fastembed models run locally) ---
# Folder with the RAG documents (.md/.txt), inside gitignore/data/. Empty = gitignore/data/<ACTIVE_COMPANY>/kb
RAG_DATA_DIR=
RAG_DENSE_MODEL=BAAI/bge-small-en-v1.5
RAG_SPARSE_MODEL=Qdrant/bm25

# --- Email (Gmail API) ---
GMAIL_CREDENTIALS_PATH=
GMAIL_SENDER=

# --- Chat (Telegram Bot API; use a dev bot) ---
TELEGRAM_BOT_TOKEN=

# --- Evals (Braintrust) ---
BRAINTRUST_API_KEY=

# --- Database (Supabase: Postgres + pgvector; use the dev project) ---
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
